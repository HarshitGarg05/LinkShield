{
  "name": "link-shield",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"python link_shield_backend/server.py\" \"npm run dev --prefix frontend\"",
    "dev:backend": "python link_shield_backend/server.py",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
